# Copy to .env and adjust. Never commit the real .env.

# Database
POSTGRES_DB=bee_pos
POSTGRES_USER=beeuser
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Security — JWT_SECRET must be at least 32 random bytes (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-use-openssl-rand-base64-48
# Password for the 'admin' account created on first start only
APP_ADMIN_PASSWORD=change-me

# Demo data (products, manager/kasir users). Set to false in production.
APP_SEED_DEMO=false
APP_TIMEZONE=Asia/Jakarta
# Only needed when the frontend is served from a different origin than the API
APP_CORS_ALLOWED_ORIGINS=https://pos.example.com

# Initial receipt header (afterwards edit it in the app: Pengaturan Toko)
STORE_NAME=BeePos Store
STORE_ADDRESS=Jl. Contoh No. 1, Jakarta

# Published ports
FRONTEND_PORT=8081
BACKEND_PORT=8080
POSTGRES_PORT=5432
